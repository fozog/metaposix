{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "metaposix: configure debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build/debug",
                "-G", "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "metaposix: build debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/debug",
                "--target", "mp_tests",
                "--parallel"
            ],
            "dependsOn": "metaposix: configure debug",
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
